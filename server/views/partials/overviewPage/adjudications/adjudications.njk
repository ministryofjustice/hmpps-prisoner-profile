{% if adjudicationSummary and isGranted(PrisonerAdjudicationsPermission.read, prisonerPermissions) %}
  {% set adjudicationsWidth = "govuk-grid-column-one-third" if propertySummary else "govuk-grid-column-one-half" %}
  <div class={{ adjudicationsWidth }} data-qa="adjudications-summary">
    {{ miniCard(adjudicationSummary | toAdjudicationsMiniSummary(prisonerNumber), '', adjudicationSummary.status != 'fulfilled') }}
  </div>
{% endif %}
