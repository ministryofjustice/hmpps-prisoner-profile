{% extends "govuk/template.njk" %}

{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "macros/hmppsError.njk" import hmppsError %}
{% from "macros/hmppsFlashMessage.njk" import hmppsFlashMessage %}

{% block head %}
  {% include "./googleTagManagerHeadScripts.njk" %}
  {% include "./appInsightsWebTracking.njk" %}

  <link href="{{ '/assets/css/index.css' | assetMap }}" rel="stylesheet"/>

  {% for js in feComponents.jsIncludes %}
    <script src="{{ js }}" nonce="{{ cspNonce }}"></script>
  {% endfor %}

  {% for css in feComponents.cssIncludes %}
    <link href="{{ css }}" nonce="{{ cspNonce }}" rel="stylesheet" />
  {% endfor %}

{% endblock %}

{% block pageTitle %}{{ 'Error: ' if errors.length > 0 }}{{ pageTitle + ' - ' + applicationName if pageTitle else applicationName }}{% endblock %}

{% block govukHeader %}
  {{ feComponents.header | safe }}
{% endblock %}

{% block beforeContent %}
  {% if pageHasApiErrors and not useCustomErrorBanner %}
    {{ hmppsError({ type: 'banner' }) }}
  {% endif %}

  {% if bannerText %}
    {% include "./banner.njk" %}
  {% endif %}

  {% if flashMessage %}
    {{ hmppsFlashMessage({
      text: flashMessage.text,
      anchored: flashMessage.fieldName
    }) }}
  {% endif %}

  <div class="prisoner-profile-breadcrumbs govuk-!-display-none-print">
    {% if not breadCrumbs %}
      {% set breadCrumbs = [
        { text: 'Digital Prison Services', href: "/" | prependBaseUrl },
        { text: breadcrumbPrisonerName | default(prisonerName.lastCommaFirst | default(prisonerName)), href: '/prisoner/' + prisonerNumber } if prisonerNumber and pageTitle != 'Overview' and isGranted(PrisonerBasePermission.read, prisonerPermissions) else null,
        breadcrumbParent
      ] | removeNullish %}
    {% endif %}

    {% set showBack = refererUrl and not breadCrumbs | length %}
    {% if not hideBackLink and (showBack or user.backLink) %}
      <div class="prisoner-profile-breadcrumbs__{{ 'back' if showBack else 'search' }}">
        <a href="{{ refererUrl if showBack else user.backLink.url }}"
          class="govuk-link govuk-link--no-visited-state"
          data-qa="{{ 'referer-back-link' if showBack else 'back-link' }}">{{ 'Back' if showBack else user.backLink.text }}
        </a>
      </div>
    {% endif %}

    {% if breadCrumbs | length %}
      <div class="prisoner-profile-breadcrumbs__breadcrumbs">
        {{ govukBreadcrumbs({ items: breadCrumbs }) }}
      </div>
    {% endif %}
  </div>
{% endblock %}

{% block bodyStart %}
  {% include "./googleTagManagerNoscript.njk" %}
  <a id="top"></a>
{% endblock %}

{% block bodyEnd %}
  {# Run JavaScript at end of the
  <body>, to avoid blocking the initial render. #}
  <script type="module" src="{{ '/assets/js/index.js' | assetMap }}"></script>

  {# Javascript block for individual pages #}
  {% block pageScripts %}
  {% endblock %}

{% endblock %}

{% block govukFooter %}
  {{ feComponents.footer | safe }}
{% endblock %}
