{% from "../../components/bannerSearch/bannerSearch.njk" import bannerSearch %}

{% if hideBanner === false %}
  <div data-test="hmpps-profile-banner-partial" class="hmpps-profile-banner">
    {% include "./profileBannerTop.njk" %}
    {% include "./profileBannerAlerts.njk" %}
    {% if duplicateRecordsFound %}
      {% include "../../partials/overviewPage/duplicatePrisonerBanner.njk" %}
    {% endif %}

    <div class="govuk-grid-row govuk-!-display-none-print">
      {{ bannerSearch(prisonerNumber, { id: "profile-banner-search", classes: "govuk-grid-column-full" }) }}
    </div>

    {% include "./profileBannerTabs.njk" %}
  </div>
{% endif %}
