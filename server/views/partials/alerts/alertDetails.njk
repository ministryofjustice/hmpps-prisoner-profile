{% from "govuk/components/button/macro.njk" import govukButton %}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <div role="list">
            {% for alert in alerts %}
                <div class="alert-details" role="listitem">
                    <div class="alert-details__content">
                        <div class="alert-details__sub-title">{{ alert.alertCode.alertTypeDescription }}</div>
                        <h2 class="alert-details__title">{{ alert.alertCode.description }}</h2>
                        <pre class="alert-details__notes govuk-body">{{ alert.description }}</pre>
                        <div class="alert-details__metadata"><span>Created:</span> {{ alert.createdAt | formatDate }} {% if alert.createdByDisplayName %} by {{ alert.createdByDisplayName }} {% endif %}</div>
                    </div>
                    <div class="alert-details__link">
                        {% if alert.addMoreDetailsLinkUrl %}
                            <a href="{{ alert.addMoreDetailsLinkUrl }}" class="govuk-link govuk-link--no-visited-state">Update or close</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <div class="govuk-button-group">
            {{ govukButton({
              text: "Close",
              href: "?",
              classes: "govuk-button--secondary hmpps-modal__trigger-hide",
              attributes: { "data-qa": "alert-details-close-button" }
            }) }}
            <a href="{{ allAlertsUrl }}" class="govuk-link govuk-link--no-visited-state" data-qa="alert-details-all-alerts-link">All alerts</a>
        </div>
    </div>
</div>
