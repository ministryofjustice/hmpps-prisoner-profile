{% macro bannerSearch(prisonerNumber, options = { id: "banner-search", label: "Navigate to:", classes: "" }) %}
  {% set searchId = options.id or "banner-search" %}
  {% set searchLabel = options.label or "Navigate to:" %}

  {% set searchSuggestions = [
    { text: "External contacts (overview)", url: "/prisoner/" + prisonerNumber + "#external-contacts" },
    { text: "Social and official contacts (list)", url: "https://contacts-dev.hmpps.service.justice.gov.uk/prisoner/" + prisonerNumber + "/contacts/list" },
    { text: "Staff contacts (overview)", url: "/prisoner/" + prisonerNumber + "#staff-contacts" },
    { text: "Professional contacts (details)", url: "/prisoner/" + prisonerNumber + "/professional-contacts" },

    { text: "Diet and food allergies (view)", url: "/prisoner/" + prisonerNumber + "/personal#diet-and-food-allergies" },
    { text: "Diet and food allergies (edit)", url: "/prisoner/" + prisonerNumber + "/personal/diet-and-food-allergies" },
    { text: "Catering instructions (view)", url: "/prisoner/" + prisonerNumber + "/personal#diet-and-food-allergies" },
    { text: "Catering instructions (edit)", url: "/prisoner/" + prisonerNumber + "/personal/diet-and-food-allergies" },
    { text: "Dietargy requirements (establishment report)", url: "https://dps-dev.prison.service.justice.gov.uk/dietary-requirements?fromDpsHeader=true" }
  ] %}

  <div class="hmpps-banner-search govuk-!-display-none-print {{ options.classes }}" role="search" data-banner-search>
    <label class="hmpps-banner-search__label" for="{{ searchId }}-input">{{ searchLabel }}</label>

    <div class="hmpps-banner-search__container">
      <div class="hmpps-banner-search__box">
        <div class="hmpps-banner-search__field">
          <input
            id="{{ searchId }}-input"
            class="hmpps-banner-search__input"
            type="search"
            name="q"
            value=""
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            role="combobox"
            aria-autocomplete="list"
            aria-controls="{{ searchId }}-results"
            aria-expanded="false"
          />

          <button type="button" class="hmpps-banner-search__clear" hidden>
            <span class="govuk-visually-hidden">Clear search</span>
            <svg class="hmpps-banner-search__clear-icon" width="14" height="14" viewBox="0 0 16 16"
                 aria-hidden="true" focusable="false">
              <path d="M1.6 0L0 1.6L6.4 8L0 14.4L1.6 16L8 9.6L14.4 16L16 14.4L9.6 8L16 1.6L14.4 0L8 6.4L1.6 0Z"
                    fill="currentColor"></path>
            </svg>
          </button>
        </div>

        <button type="button" class="hmpps-banner-search__submit">
          <span class="govuk-visually-hidden">Search</span>
          <svg class="hmpps-banner-search__submit-icon" width="27" height="27" viewBox="0 0 27 27"
               fill="none" aria-hidden="true" focusable="false">
            <circle cx="12.0161" cy="11.0161" r="8.51613" stroke="currentColor" stroke-width="3"></circle>
            <line x1="17.8668" y1="17.3587" x2="26.4475" y2="25.9393" stroke="currentColor" stroke-width="3"></line>
          </svg>
        </button>
      </div>

      <ul id="{{ searchId }}-results" class="hmpps-banner-search__results" role="listbox" hidden>
        {% for suggestion in searchSuggestions %}
          <li class="hmpps-banner-search__result" role="option" data-search-text="{{ suggestion.text }}" hidden>
            <a href="{{ suggestion.url }}">
              <svg class="hmpps-banner-search__result-icon" width="20" height="20" viewBox="0 0 27 27"
                   fill="none" aria-hidden="true" focusable="false">
                <circle cx="12.0161" cy="11.0161" r="8.51613" stroke="currentColor" stroke-width="3"></circle>
                <line x1="17.8668" y1="17.3587" x2="26.4475" y2="25.9393" stroke="currentColor"
                      stroke-width="3"></line>
              </svg>
              <span class="hmpps-banner-search__result-text">{{ suggestion.text }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
{% endmacro %}
