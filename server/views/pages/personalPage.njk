{% extends "./index.njk" %}
{% from "macros/sidebarNav.njk" import sidebarNav %}
{% from "macros/conditionallyShow.njk" import conditionallyShow %}
{% from "macros/hmppsError.njk" import hmppsError %}

{% block body %}
  {% if pageHasApiErrors and useCustomErrorBanner %}
    <div class="govuk-grid-row">
      {{ hmppsError({ type: 'banner', classes: 'govuk-!-margin-3' }) }}
    </div>
  {% endif %}

  {% set sections = [
    {
      text: "Personal details",
      href: "#personal-details",
      template: "partials/personalPage/personalDetails.njk"
    },
    {
      text: "Identity numbers",
      href: "#identity-numbers",
      template: "partials/personalPage/identityNumbers.njk"
      condition: isGranted(CorePersonRecordPermission.read_identifiers, prisonerPermissions)
    },
    {
      text: "Care needs",
      href: "#care-needs",
      template: "partials/personalPage/careNeeds.njk"
    },
    {
      text: "Neurodiversity",
      href: "#neurodiversity",
      template: "partials/personalPage/neurodiversity.njk",
      condition: neurodiversityEnabled(user.activeCaseLoadId) and learnerNeurodivergence.status === 'fulfilled' and learnerNeurodivergence.value.length
    },
    {
      text: "Appearance",
      href: "#appearance",
      template: "partials/personalPage/appearance.njk",
      condition: isGranted(CorePersonRecordPermission.read_physical_characteristics, prisonerPermissions) or isGranted(CorePersonRecordPermission.read_distinguishing_marks, prisonerPermissions)
    },
    {
      text: "Addresses",
      href: "#addresses",
      template: "partials/personalPage/addresses.njk" if displayNewAddressesCard else "partials/personalPage/oldAddresses.njk",
      condition: isGranted(CorePersonRecordPermission.read_address, prisonerPermissions)
    },
    {
      id: "global-numbers-and-email-addresses"
      text: "Phone and email",
      href: "#phones-and-emails",
      template: "partials/personalPage/globalNumbersAndEmailAddresses.njk",
      condition: isGranted(CorePersonRecordPermission.read_phone_numbers, prisonerPermissions) or isGranted(CorePersonRecordPermission.read_email_addresses, prisonerPermissions)
    },
    {
      text: "Next of kin",
      href: "#next-of-kin",
      template: "partials/personalPage/nextOfKin.njk" if personalRelationshipsApiReadEnabled else "partials/personalPage/oldNextOfKin.njk",
      condition: isGranted(PersonalRelationshipsPermission.read_emergency_contacts, prisonerPermissions)
    },
    {
      text: "Security",
      href: "#security",
      template: "partials/personalPage/security.njk"
    },
    {
      text: "Property",
      href: "#property",
      template: "partials/personalPage/property.njk",
      condition: isGranted(PrisonerPropertyPermission.read_property_details, prisonerPermissions)
    }
  ] %}

  {% set sidebar %}
    {{ sidebarNav(sections) }}
  {% endset %}

  {% set content %}
    <div class="hmpps-profile--personal-content hmpps-full-width-print {{ 'new-arrival' if newArrival72 }}">
      {% for section in sections %}
        {% set sectionHtml %}
          <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
              {% include section.template %}
            </div>
          </div>
        {% endset %}

        {% if section.condition != null %}
          {%- call conditionallyShow({condition: section.condition, id: section.id or section.href | replace('#', '')}) -%}
            {{ sectionHtml | safe }}
          {%- endcall -%}
        {% else %}
          {{ sectionHtml | safe }}
        {% endif %}
      {% endfor %}
    </div>
  {% endset %}

  {% set heading = "Personal" %}
  {% include "partials/sidebarPageLayout.njk" %}
{% endblock %}
