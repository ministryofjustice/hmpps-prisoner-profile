{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "partials/phoneNumberRow/macros/phoneNumberRow.njk" import phoneNumberRow %}
{% extends "./editPage.njk" %}
{% block form %}
  <form method="post" novalidate="novalidate" autocomplete="off">
    {% call govukFieldset({
      legend: {
        text: formTitle if formTitle else pageTitle,
        classes: "govuk-fieldset__legend--l",
        isPageHeading: true
      }
    }) %}
    <input type="hidden" name="_csrf" value="{{ csrfToken }}"/>
    {% set formPhoneNumbers = phoneNumbers if phoneNumbers else [{
      phoneNumberType: '',
      phoneNumber: phoneNumber,
      phoneExtension: phoneExtension,
      index: 0,
      phoneTypeOptions: phoneTypeOptions
    }] %}
    {% for phone in formPhoneNumbers %}
      <div id="phone-number-section-{{ phone.index }}">
        {% if addAnotherEnabled and formPhoneNumbers.length > 1 %}
          <h2 class="govuk-heading-m">Phone number {{ loop.index }} of {{ formPhoneNumbers.length }}</h2>
        {% endif %}
        {{ phoneNumberRow(phone, errors, addAnotherEnabled, true) }}
      </div>
      {% if addAnotherEnabled and formPhoneNumbers.length > 1 %}
        {{ govukButton({
          text: "Remove phone number " + loop.index,
          type: "submit",
          classes: "govuk-button--secondary govuk-!-margin-bottom-0",
          attributes: {
            name: "removePhoneNumber",
            value: phone.index,
            formaction: "?removePhoneNumber=" + phone.index,
            "data-qa": "remove-global-phone-number-" + phone.index
          }
        }) }}
        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" aria-hidden="true" />
      {% endif %}
    {% endfor %}
    {% endcall %}
    {% if addAnotherEnabled %}
      <div class="govuk-button-group">
        {{ govukButton({
          text: "Add another phone number",
          id: "submit-and-add-another",
          type: "submit",
          preventDoubleClick: true,
          classes: "govuk-button--secondary hmpps-button__add-another"
        }) }}
      </div>
    {% endif %}
    <div class="govuk-button-group">
      {{ govukButton({
        text: submitButtonText if submitButtonText else "Save",
        type: "submit",
        preventDoubleClick: true,
        attributes: { "data-qa": "edit-submit-button" }
      }) }}
      <a
        href="/prisoner/{{ prisonerNumber }}/personal#phones-and-emails"
        class="govuk-link govuk-link--no-visited-state"
        data-qa="edit-cancel-button">Cancel</a>
    </div>
  </form>
{% endblock %}
