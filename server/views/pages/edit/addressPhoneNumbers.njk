{% extends "./editPage.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}


{% set addressHtml %}
  <div class="address-summary">
    {% for line in addressLines %}
      <p class="govuk-!-static-margin-0">{{ line }}</p>
    {% endfor %}
  </div>
{% endset %}

{% block form %}
  <h1 class="govuk-heading-l">{{ formTitle }}</h1>
  {{ govukInsetText({ html: addressHtml }) }}
  <form method="post" novalidate="novalidate" autocomplete="off">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    {% for phoneNumber in phoneNumbers %}
      {% if phoneNumbers.length > 1 %}
        <h2 class="govuk-heading-m">Phone number {{ loop.index }} of {{ phoneNumbers.length }}</h2>
      {% endif %}
      {%
        call govukFieldset({
          legend: {
            text: "Phone number type",
            classes: "govuk-fieldset__legend--s govuk-!-font-weight-bold",
            isPageHeading: false
          }
        })
      %}
        {{
          govukRadios({
            name: "phoneNumberType" + phoneNumber.index,
            id: "phone-number-type-" + phoneNumber.index,
            items: phoneNumber.phoneTypeOptions,
            errorMessage: { text: (errors | findError("phone-number-type-" + phoneNumber.index)).text } if errors | findError("phone-number-type-" + phoneNumber.index)
          })
        }}
        {{
          govukInput({
            label: { text: "Phone number", classes: "govuk-!-font-weight-bold" },
            id: "phone-number-" + phoneNumber.index,
            name: "phoneNumber" + phoneNumber.index,
            classes: "govuk-input--width-20",
            value: phoneNumber.phoneNumber,
            errorMessage: { text: (errors | findError("phone-number-" + phoneNumber.index)).text } if errors | findError("phone-number-" + phoneNumber.index)
          })
        }}
        {{
          govukInput({
            label: { text: "Extension (optional)", classes: "govuk-!-font-weight-bold" },
            id: "phone-extension-" + phoneNumber.index,
            name: "phoneExtension" + phoneNumber.index,
            classes: "govuk-input--width-5",
            value: phoneNumber.phoneExtension,
            errorMessage: { text: (errors | findError("phone-extension-" + phoneNumber.index)).text } if errors | findError("phone-extension-" + phoneNumber.index)
          })
        }}
      {% endcall %}
      {% if phoneNumbers.length > 1 %}
        {{
          govukButton({
            text: "Remove phone number " + loop.index,
            type: "submit",
            classes: "govuk-button--secondary govuk-!-margin-bottom-0",
            attributes: {
              formaction: "?removePhoneNumber=" + phoneNumber.index,
              "data-qa": "remove-address-phone-number-" + phoneNumber.index
            }
          })
        }}
        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" aria-hidden="true" />
      {% endif %}
    {% endfor %}
    <div class="govuk-button-group">
      {{
        govukButton({
          text: "Save and return to profile",
          type: "submit",
          preventDoubleClick: true,
          attributes: { "data-qa": "save-address-phone-numbers" }
        })
      }}
      {{
        govukButton({
          text: "Add another phone number",
          id: "submit-and-add-another",
          type: "submit",
          classes: "govuk-button--secondary hmpps-button__add-another",
          preventDoubleClick: true,
          attributes: { name: "submitAction", value: "addAnother", "data-qa": "add-another-phone-number" }
        })
      }}
      <a
        href="/prisoner/{{ prisonerNumber }}/personal"
        class="govuk-link govuk-link--no-visited-state"
        data-qa="cancel-link"
        >Cancel</a
      >
    </div>
  </form>
{% endblock %}
