{% extends "../index.njk" %}

{% set breadcrumbParent = { text: 'Personal', href: "/prisoner/" + prisonerNumber + "/personal" } %}

{% from "../../macros/summaryCardMacro.njk" import summaryCard %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set canEditAddressPhoneNumbers = editAddressSpecificPhoneNumbersEnabled and editEnabled and isGranted(CorePersonRecordPermission.edit_address, prisonerPermissions) %}


{% block body %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-l govuk-!-margin-top-1 govuk-!-margin-bottom-7">{{ prisonerName.firstLast | apostrophe }} addresses</h1>
    </div>
</div>

<div class="govuk-grid-row hmpps-three-quarters-responsive">
    <div class="govuk-grid-column-three-quarters hmpps-full-width-print address-cards">

    {% if primaryAddress %}
    {%- call summaryCard({title: primaryAddressLabel, id: "primary-address"}) -%}
        <div class="govuk-grid-row" data-qa="primary-address">
            <div class="govuk-grid-column-full">
                {{ govukSummaryList({
                    rows: primaryAddress | addressToSummaryItems(prisonerNumber, canEditAddressPhoneNumbers, editAddressSpecificPhoneNumbersEnabled)
                }) }}
            </div>
        </div>
    {%- endcall -%}
    {% endif %}

    {% if mailAddress %}
    {%- call summaryCard({title: "Postal address", id: "mail-address"}) -%}
        <div class="govuk-grid-row" data-qa="mail-address">
            <div class="govuk-grid-column-full">
                {{ govukSummaryList({
                    rows: mailAddress | addressToSummaryItems(prisonerNumber, canEditAddressPhoneNumbers, editAddressSpecificPhoneNumbersEnabled)
                }) }}
            </div>
        </div>
    {%- endcall -%}
    {% endif %}

    {% if otherAddresses.length > 0 %}
    {%- call summaryCard({title: "Other active addresses", id: "other-addresses"}) -%}
        {% for address in otherAddresses %}
        <div class="govuk-grid-row" data-qa="other-address">
            <div class="govuk-grid-column-full">
                {{ govukSummaryList({
                    classes: '' if loop.last else 'govuk-!-margin-bottom-0',
                    rows: address | addressToSummaryItems(prisonerNumber, canEditAddressPhoneNumbers, editAddressSpecificPhoneNumbersEnabled)
                }) }}
                {% if not loop.last %}<hr class="govuk-section-break govuk-section-break--visible" aria-hidden="true">{% endif %}
            </div>
        </div>
        {% endfor %}
    {%- endcall -%}
    {% endif %}

    {% if not primaryAddress and not mailAddress and otherAddresses.length === 0 %}
        <div data-qa="no-addresses-message">No addresses have been entered.</div>
    {% endif %}

    </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <a class="govuk-link govuk-link--no-visited-state govuk-!-display-none-print" href="/prisoner/{{ prisonerNumber }}/personal#addresses" data-qa="addresses-back-link">Return to prisoner’s profile</a>
  </div>
</div>

{% endblock %}
